-    public void SetConsoleTitle(string title)
-    {
-        if (StdoutRedirected)
-            return;
-
-        if (UseMonoTtyDriver && SafeConsole.TitleExists)
-            SafeConsole.Title = title;
-        else
-            ConsoleOut.Write($"\u001B]2;{title.Replace("\\", "\\\\")}\u0007");
-    }
-}
