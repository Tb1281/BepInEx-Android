-        if [ -z "$LD_PRELOAD" ]; then
-            export LD_PRELOAD="${doorstop_name}"
-        else
-            export LD_PRELOAD="${doorstop_name}:${LD_PRELOAD}"
-        fi
-
-        exec "$executable_path" "$@"
-    ;;
-    Darwin*)
