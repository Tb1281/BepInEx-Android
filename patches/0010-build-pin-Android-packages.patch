From 16eda0465abd5b4883ae8776b6354af85ac0743a Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Wed, 21 Oct 2026 12:58:14 +0900
Subject: [PATCH] build: pin the Android package set (Il2CppInterop, MonoMod, Cpp2IL)


Collapses the former 0010/0011/0013 serial hunk-context chain into a
single patch applied after the build retarget. The three pins touched
the same csproj files in sequence, so an upstream edit to any of them
broke the first hunk and cascaded through the rest. One patch gives
one conflict surface and one re-record.

Depends-On: 0005-build-retarget-the-project-files-at-the-Android-IL2C
---
 BepInEx.Core/BepInEx.Core.csproj                       |  4 ++--
 BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj   |  4 ++--
 .../BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj   | 10 +++++-----
 nuget.config                                           |  6 +++++-
 4 files changed, 14 insertions(+), 10 deletions(-)

diff --git a/BepInEx.Core/BepInEx.Core.csproj b/BepInEx.Core/BepInEx.Core.csproj
index 01a52d5..0d6866f 100644
--- a/BepInEx.Core/BepInEx.Core.csproj
+++ b/BepInEx.Core/BepInEx.Core.csproj
@@ -10,8 +10,8 @@
         <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/>
         <PackageReference Include="HarmonyX" Version="2.10.2" />
         <PackageReference Include="SemanticVersioning" Version="2.0.2"/>
-        <PackageReference Include="MonoMod.Utils" Version="25.0.12-star"/>
-        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4-star"/>
+        <PackageReference Include="MonoMod.Utils" Version="25.3.7-android.1"/>
+        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.7-android.1"/>
     </ItemGroup>
     <ItemGroup>
         <Compile Remove="Contract\IPlugin.cs"/>
diff --git a/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj b/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
index c6099ef..9ea6b70 100644
--- a/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
+++ b/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
@@ -9,7 +9,7 @@
     <ItemGroup>
         <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/>
         <PackageReference Include="HarmonyX" Version="2.10.2" />
-        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4-star"/>
-        <PackageReference Include="MonoMod.Utils" Version="25.0.12-star"/>
+        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.7-android.1"/>
+        <PackageReference Include="MonoMod.Utils" Version="25.3.7-android.1"/>
     </ItemGroup>
 </Project>
diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
index bb3b809..309c844 100644
--- a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
@@ -16,14 +16,14 @@
     <ItemGroup>
         <PackageReference Include="HarmonyX" Version="2.16.0" />
         <PackageReference Include="Iced" Version="1.21.0" />
-        <PackageReference Include="Il2CppInterop.Generator" Version="1.5.2-ci.star.12" />
-        <PackageReference Include="Il2CppInterop.HarmonySupport" Version="1.5.2-ci.star.12" />
+        <PackageReference Include="Il2CppInterop.Generator" Version="[1.5.3-android.1]" />
+        <PackageReference Include="Il2CppInterop.HarmonySupport" Version="[1.5.3-android.1]" />
         <PackageReference Include="Il2CppInterop.ReferenceLibs" Version="1.0.0" IncludeAssets="compile" PrivateAssets="all" />
-        <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.2-ci.star.12" />
+        <PackageReference Include="Il2CppInterop.Runtime" Version="[1.5.3-android.1]" />
         <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
         <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" />
-        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4-star" />
-        <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-development.1452" />
+        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.7-android.1" />
+        <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.21" />
     </ItemGroup>
     <ItemGroup>
         <Reference Include="Unity.InputSystem">
diff --git a/nuget.config b/nuget.config
index 5e67f2a..d156c1f 100644
--- a/nuget.config
+++ b/nuget.config
@@ -2,6 +2,10 @@
 <configuration>
   <packageSources>
     <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
-    <add key="Samboy" value="https://nuget.samboy.dev/v3/index.json" />
+    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
+    <!-- Self-built Il2CppInterop / MonoMod fork packages live here;
+         `scripts/build_il2cppinterop.sh` repopulates it.
+         Relative to this file -> <repo>/local-nuget -->
+    <add key="local" value="../../local-nuget" />
   </packageSources>
 </configuration>
-- 
2.53.0

