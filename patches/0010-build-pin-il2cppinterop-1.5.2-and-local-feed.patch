From eda587b2fae2a283a5398b32d56d33f33bc8dd62 Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Wed, 7 Oct 2026 15:37:35 +0900
Subject: [PATCH] build: pin Il2CppInterop 1.5.2 and resolve from the local
 feed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The dead nuget.samboy.dev feed (Il2CppInterop fork, MonoMod.RuntimeDetour)
is a supply-chain risk; resolve them from the in-repo local-nuget directory
rebuilt by scripts/build_il2cppinterop.sh instead. Backup copy from upstream's
may-2026 feed is gone, so the Samboy reference stays dead — this makes the
build self-contained.

Depends-On: 0005-build-retarget-the-project-files-at-the-Android-IL2C
---
 .../Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj  | 6 +++---
 nuget.config                                                | 6 +++++-
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
index bb3b809..2ffd99d 100644
--- a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
@@ -16,10 +16,10 @@
     <ItemGroup>
         <PackageReference Include="HarmonyX" Version="2.16.0" />
         <PackageReference Include="Iced" Version="1.21.0" />
-        <PackageReference Include="Il2CppInterop.Generator" Version="1.5.2-ci.star.12" />
-        <PackageReference Include="Il2CppInterop.HarmonySupport" Version="1.5.2-ci.star.12" />
+        <PackageReference Include="Il2CppInterop.Generator" Version="[1.5.3-android.1]" />
+        <PackageReference Include="Il2CppInterop.HarmonySupport" Version="[1.5.3-android.1]" />
         <PackageReference Include="Il2CppInterop.ReferenceLibs" Version="1.0.0" IncludeAssets="compile" PrivateAssets="all" />
-        <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.2-ci.star.12" />
+        <PackageReference Include="Il2CppInterop.Runtime" Version="[1.5.3-android.1]" />
         <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
         <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" />
         <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4-star" />
diff --git a/nuget.config b/nuget.config
index 5e67f2a..d156c1f 100644
--- a/nuget.config
+++ b/nuget.config
@@ -2,6 +2,10 @@
 <configuration>
   <packageSources>
     <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
-    <add key="Samboy" value="https://nuget.samboy.dev/v3/index.json" />
+    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
+    <!-- Self-built Il2CppInterop / MonoMod fork packages live here;
+         `scripts/build_il2cppinterop.sh` repopulates it.
+         Relative to this file -> <repo>/local-nuget -->
+    <add key="local" value="../../local-nuget" />
   </packageSources>
 </configuration>
-- 
2.53.0

