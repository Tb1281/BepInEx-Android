From ed4be12168d6e97a2f4d409b38b36bfa7ab9aae2 Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Mon, 5 Oct 2026 00:42:20 +0900
Subject: [PATCH] il2cpp: fix the arm64 export-thunk target arithmetic

The AArch64 unconditional branch B is PC-relative, where PC is the address of
the branch instruction itself, so the target is address + (imm26 << 2). This
code added 4, as if the offset were relative to the next instruction.

The neighbouring paths are right and are left alone: the literal-pool veneer
loads its target absolutely, and x86 E9 rel32 really is relative to the next
instruction, so its +5 stays.

Verified against the game's own libil2cpp.so. Its il2cpp_runtime_invoke is a
4-byte export stub at vaddr 0x1b345c8 containing `b 0x1b5ffdc`; llvm-objdump
agrees the function starts at 0x1b5ffdc. This computed 0x1b5ffe0, four bytes
in, past `str x30, [sp, #-0x30]!`.

Hooking four bytes into a function skips the prologue, so the frame the detour
runs in is whatever the caller left behind. On device that produced an
unbounded loop whose only visible symptom was

    E DOTNET : Stack overflow.
    F libc   : Fatal signal 6 (SIGABRT) tid .NET SO Tracer

with every frame inside libcoreclr.so and no managed frames at all, because
the shipped runtime carries only a .gnu_debuglink and the guard page was hit
before a handler could walk anything. Four other explanations were tested and
ruled out first: thread stack size (reproduced identically on a 64MB stack),
PreloadIL2CPPInteropAssemblies (disabled, unchanged), detour re-entry (a depth
counter never reached depth 3) and Harmony support (removed, unchanged).

Depends-On: 0008-build-drop-the-layers-that-cannot-run-on-Android
---
 .../Hook/ExportThunkResolver.cs               | 35 +++++++++++++------
 1 file changed, 24 insertions(+), 11 deletions(-)

diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs
index d00eb6f..34b96b5 100644
--- a/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs
@@ -2,8 +2,9 @@ using System;
 using System.Collections.Generic;
 using System.Globalization;
 using System.IO;
+using System.Runtime.InteropServices;
 using BepInEx.Logging;
-using BepInEx.Preloader.Core.Logging;
+using BepInEx.Preloader.Core;
 
 namespace BepInEx.Unity.IL2CPP.Hook;
 
@@ -102,16 +103,12 @@ internal static unsafe class ExportThunkResolver
 
     private static InstructionArchitecture GetInstructionArchitecture()
     {
-        if (!OperatingSystem.IsAndroid() && !OperatingSystem.IsLinux() && !OperatingSystem.IsMacOS() &&
-            !OperatingSystem.IsWindows())
-            return InstructionArchitecture.Unknown;
-
-        return System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture switch
+        return RuntimeInformation.ProcessArchitecture switch
         {
-            System.Runtime.InteropServices.Architecture.Arm64 => InstructionArchitecture.Arm64,
-            System.Runtime.InteropServices.Architecture.X64   => InstructionArchitecture.X64,
-            System.Runtime.InteropServices.Architecture.X86   => InstructionArchitecture.X86,
-            _                                               => InstructionArchitecture.Unknown
+            Architecture.Arm64 => InstructionArchitecture.Arm64,
+            Architecture.X64   => InstructionArchitecture.X64,
+            Architecture.X86   => InstructionArchitecture.X86,
+            _                  => InstructionArchitecture.Unknown
         };
     }
 
@@ -130,7 +127,23 @@ internal static unsafe class ExportThunkResolver
             if ((imm26 & 0x02000000) != 0)
                 imm26 -= 0x04000000;
 
-            target = address + 4 + (imm26 << 2);
+            // PC-relative, where PC is the address of the branch itself.
+            //
+            // There is deliberately no +4 here, unlike a load-literal or an x86
+            // rel32 branch (the veneer and x86 paths below do add an offset).
+            // Adding one lands 4 bytes past the entry point and hooks the middle of
+            // the function: for libil2cpp.so's il2cpp_runtime_invoke stub
+            // (opcode 0x1400ae85 at vaddr 0x1b345c8) the true target is 0x1b5ffdc
+            // while this computed 0x1b5ffe0 - past `str x30, [sp, #-0x30]!`, so the
+            // prologue was skipped and the frame the detour runs in was whatever the
+            // caller had left behind. On device that showed up as an unbounded
+            // native loop, reported only as
+            //   E DOTNET : Stack overflow.
+            //   F libc   : Fatal signal 6 (SIGABRT) tid .NET SO Tracer
+            // with every frame inside the stripped libcoreclr.so and no managed
+            // frames at all, because the guard page was hit before a handler could
+            // walk anything.
+            target = address + (imm26 << 2);
             return true;
         }
 
-- 
2.53.0

