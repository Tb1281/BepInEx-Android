diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs
new file mode 100644
index 0000000..d00eb6f
--- /dev/null
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/ExportThunkResolver.cs
@@ -0,0 +1,239 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using BepInEx.Logging;
+using BepInEx.Preloader.Core.Logging;
+
+namespace BepInEx.Unity.IL2CPP.Hook;
+
+/// <summary>
+///     Resolves the address of a native library export to the address of the function body that should be
+///     hooked.
+/// </summary>
+/// <remarks>
+///     <para>
+///         Native linkers routinely place a stub in the export table instead of the function body itself.
+///         On Windows the stub is a <c>jmp rel32</c> (<c>E9</c>) or a <c>jmp [rip+disp32]</c> (<c>FF 25</c>);
+///         on ELF platforms, which is what Android games use, it is a single <c>B</c> instruction, sometimes
+///         followed by a literal-pool veneer.
+///     </para>
+///     <para>
+///         Inline hook engines such as Dobby need at least a handful of relocatable instructions to work
+///         with, and a 4-byte stub does not have them: patching one yields a broken prologue (and, on
+///         AArch64 with pointer authentication, a <c>SIGILL</c>). Following the stub explicitly, the way
+///         the Android port of BepInEx does through
+///         <c>XrefScannerLowLevel.JumpTargets(...).First()</c>, keeps the resolution bounded, architecture
+///         aware and verifiable, and avoids reading a speculative window of memory past the end of the
+///         stub.
+///     </para>
+///     <para>
+///         Forms that are not recognised are returned unchanged after validation, because a thunk that this
+///         decoder does not understand (an <c>adrp</c>/<c>add</c>/<c>ldr</c>/<c>br</c> sequence, for example)
+///         is still a real function body that can be hooked safely.
+///     </para>
+/// </remarks>
+internal static unsafe class ExportThunkResolver
+{
+    /// <summary>Maximum number of stub hops to follow before giving up.</summary>
+    private const int MAX_HOPS = 8;
+
+    private static List<KeyValuePair<ulong, ulong>> executableRegions;
+
+    /// <summary>
+    ///     Follows the export stub of <paramref name="export"/> and returns the address of the function body.
+    /// </summary>
+    /// <param name="export">Address of the native export.</param>
+    /// <param name="exportName">Name of the export, used for diagnostics only.</param>
+    /// <exception cref="InvalidOperationException">
+    ///     The export is null, or does not lead to a mapped executable address.
+    /// </exception>
+    public static nint Resolve(nint export, string exportName)
+    {
+        if (export == 0)
+            throw new InvalidOperationException($"Native export '{exportName}' resolved to a null address.");
+
+        var hops = new List<string>(MAX_HOPS);
+        var current = export;
+
+        for (var hop = 0; hop < MAX_HOPS && TryFollowThunk(current, out var next); hop++)
+        {
+            // A stub that branches to itself is a cycle, not a function body.
+            if (next == 0 || next == current)
+                break;
+
+            hops.Add($"0x{current.ToInt64():X}=>{next.ToInt64():X}");
+            current = next;
+        }
+
+        if (!IsExecutable(current))
+            throw new InvalidOperationException(
+                $"Native export '{exportName}' does not lead to a mapped executable address: " +
+                $"start=0x{export.ToInt64():X}, " +
+                (hops.Count == 0 ? "no stub recognised" : $"hops={string.Join(",", hops)}"));
+
+        if (hops.Count > 0)
+            PreloaderLogger.Log.Log(LogLevel.Info,
+                                    $"Resolved {exportName} export stub: 0x{export.ToInt64():X}=>{current.ToInt64():X} ({hops.Count} hop(s))");
+
+        return current;
+    }
+
+    /// <summary>
+    ///     Decodes the single instruction at <paramref name="address"/> and, if it is a forwarding stub,
+    ///     stores the address it forwards to in <paramref name="target"/>.
+    /// </summary>
+    private static bool TryFollowThunk(nint address, out nint target)
+    {
+        target = 0;
+
+        // Every architecture handled here is little-endian, so a 32-bit read yields the instruction word.
+        switch (GetInstructionArchitecture())
+        {
+            case InstructionArchitecture.Arm64:
+                return TryFollowArm64Thunk(address, out target);
+            case InstructionArchitecture.X86:
+            case InstructionArchitecture.X64:
+                return TryFollowX86Thunk(address, out target);
+            default:
+                return false;
+        }
+    }
+
+    private static InstructionArchitecture GetInstructionArchitecture()
+    {
+        if (!OperatingSystem.IsAndroid() && !OperatingSystem.IsLinux() && !OperatingSystem.IsMacOS() &&
+            !OperatingSystem.IsWindows())
+            return InstructionArchitecture.Unknown;
+
+        return System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture switch
+        {
+            System.Runtime.InteropServices.Architecture.Arm64 => InstructionArchitecture.Arm64,
+            System.Runtime.InteropServices.Architecture.X64   => InstructionArchitecture.X64,
+            System.Runtime.InteropServices.Architecture.X86   => InstructionArchitecture.X86,
+            _                                               => InstructionArchitecture.Unknown
+        };
+    }
+
+    private static bool TryFollowArm64Thunk(nint address, out nint target)
+    {
+        target = 0;
+
+        var opcode = *(uint*)address;
+
+        // B <label>: 0b0001_01xx_xxxx_xxxx_xxxx_xxxx_xxxx_xxxx
+        if ((opcode & 0xFC000000u) == 0x14000000u)
+        {
+            var imm26 = (int)(opcode & 0x03FFFFFFu);
+
+            // imm26 is a signed 26-bit value in units of 4 bytes.
+            if ((imm26 & 0x02000000) != 0)
+                imm26 -= 0x04000000;
+
+            target = address + 4 + (imm26 << 2);
+            return true;
+        }
+
+        // Literal-pool veneer, as emitted for long-range forwarding stubs:
+        //   0x00  LDR X16, <label>   (label = this instruction + 8)
+        //   0x04  BR   X16
+        //   0x08  .quad <target>
+        if (opcode == 0x58000050u && *(uint*)(address + 4) == 0xD61F0200u)
+        {
+            target = *(nint*)(address + 8);
+            return true;
+        }
+
+        return false;
+    }
+
+    private static bool TryFollowX86Thunk(nint address, out nint target)
+    {
+        target = 0;
+
+        var opcode = *(byte*)address;
+
+        // E9 <rel32>: jmp rel32
+        if (opcode == 0xE9)
+        {
+            target = address + 5 + *(int*)(address + 1);
+            return true;
+        }
+
+        // FF 25 <disp32>: jmp [rip + disp32]
+        if (opcode == 0xFF && *(byte*)(address + 1) == 0x25)
+        {
+            var slot = GetInstructionArchitecture() == InstructionArchitecture.X64
+                ? address + 6 + *(int*)(address + 2)
+                : (nint)(uint)*(int*)(address + 2);
+
+            target = *(nint*)slot;
+            return true;
+        }
+
+        return false;
+    }
+
+    /// <summary>
+    ///     Checks that <paramref name="address"/> falls inside a mapped executable region.
+    /// </summary>
+    private static bool IsExecutable(nint address)
+    {
+        if (address == 0)
+            return false;
+
+        var target = (ulong)address.ToInt64();
+
+        executableRegions ??= ReadExecutableRegions();
+
+        foreach (var region in executableRegions)
+        {
+            if (target >= region.Key && target < region.Value)
+                return true;
+        }
+
+        return false;
+    }
+
+    private static List<KeyValuePair<ulong, ulong>> ReadExecutableRegions()
+    {
+        var regions = new List<KeyValuePair<ulong, ulong>>();
+
+        if (!File.Exists("/proc/self/maps"))
+        {
+            // Not a Linux-style platform; validation is not possible, so do not block the caller.
+            return regions;
+        }
+
+        foreach (var line in File.ReadLines("/proc/self/maps"))
+        {
+            var separator = line.IndexOf(' ');
+            if (separator < 0)
+                continue;
+
+            var bounds = line.Substring(0, separator).Split('-');
+            if (bounds.Length != 2)
+                continue;
+
+            // perms start one field after the bounds, e.g. "r-xp".
+            var perms = line.Substring(separator + 1, 4);
+            if (perms.Length != 4 || perms[2] != 'x')
+                continue;
+
+            if (ulong.TryParse(bounds[0], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var start) &&
+                ulong.TryParse(bounds[1], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var end) &&
+                end > start)
+                regions.Add(new KeyValuePair<ulong, ulong>(start, end));
+        }
+
+        return regions;
+    }
+
+    private enum InstructionArchitecture
+    {
+        Unknown,
+        X86,
+        X64,
+        Arm64
+    }
+}
