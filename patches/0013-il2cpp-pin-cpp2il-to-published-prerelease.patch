From 5b766a3b7f6c164d4798924a93f3acf4db769d06 Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Tue, 13 Oct 2026 12:00:00 +0900
Subject: [PATCH] il2cpp: pin Cpp2IL to a published prerelease

Upstream pins Samboy063.Cpp2IL.Core 2022.1.0-development.1452, which no
reachable feed serves: it resolves only out of a stale global cache, and
clean machines fall back to whatever prerelease NuGet picks that day
(measured: pre-release.13 on CI against development.1452 from cache).
Different closures compile to different assemblies, so the pin as written
makes reproducible builds impossible. Point it at the newest published
prerelease instead; the transitive Disarm/Iced that come with it both
exist upstream.

diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
index a6a6d51..ec9814e 100644
--- a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
@@ -23,7 +23,7 @@
         <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
         <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" />
         <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.7-android.1" />
-        <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-development.1452" />
+        <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.21" />
     </ItemGroup>
     <ItemGroup>
         <Reference Include="Unity.InputSystem">
