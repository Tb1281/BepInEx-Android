# LSPlant (ART hook framework) build provenance.
# Consumed by scripts/build_native_deps.sh, which clones the pinned commit into
# the gitignored build/ tree and asserts it before compiling.
#
# LSPlant is the Java/ART half of the hook engine, replacing Pine (see the ADR
# superseding docs/adr/0019-retain-gpl-and-pine.md). The launcher's hook sites
# call it through the Kotlin facade in com.bepinex.android.hooks, whose native
# shim (libhookengine.so) links this liblsplant.so. Pine's Anti-996 license was
# the open legal blocker ADR-0019 recorded; LSPlant is LGPL-3.0, which closes
# that review, and its callback model (real Java methods holding real
# references) removes the raw-address/GC race behind the Pine bridge crashes.
#
# The pin is a master snapshot (see UPSTREAM_COMMIT): the v6.4 release tag
# predates upstream's completed Android 17 support — it cannot initialize on
# the Android 17 ART this project targets (several internal ART entry points
# it requires were inlined, renamed, or removed there, and upstream made
# them optional or added their replacements only after v6.4). Nothing from
# a fork is taken and no prebuilt
# .so is trusted as an opaque input: liblsplant.so is compiled from these exact
# sources on a CI runner, which is what makes the artifact attestable to this
# run and commit. Building from source (rather than consuming the Maven prefab
# AAR) is also what lets the build set -Wl,-z,max-page-size=16384: the
# published AAR's liblsplant.so has 4KB LOAD alignment and would fail the
# 16KB gate in scripts/check_elf_alignment.sh.
UPSTREAM_URL=https://github.com/LSPosed/LSPlant
# The ref the pin is compared against by scripts/check_upstream_pins.sh.
UPSTREAM_REF=master
UPSTREAM_COMMIT=6ac2280d8d88e14f0864c26ac97c1dc96713bde1

# LSPlant carries one build-relevant submodule: DexBuilder, which generates
# the hook stub classes at runtime. Its commit is the gitlink recorded in the
# pinned tree, and DexBuilder's own nested submodule (parallel_hashmap) is the
# gitlink recorded in DexBuilder's tree. Both are recorded here and asserted
# by build_native_deps.sh: the clone checks submodules out at the default
# branch's gitlinks before the pinned commit is detached, so without re-pinning
# after checkout, two runs of the same top-level pin could compile different
# code.
#
# The test-only submodules (lsparself, lsprism, doxygen-awesome-css) are not
# fetched: the launcher's shim resolves libart symbols with its own ELF
# parser, and the test app is not built.
LSPLANT_SUBMODULE_DEXBUILDER_PATH=lsplant/src/main/jni/external/dex_builder
LSPLANT_SUBMODULE_DEXBUILDER_URL=https://github.com/LSPosed/DexBuilder.git
LSPLANT_SUBMODULE_DEXBUILDER_COMMIT=ac7fb2230954ee311808bad469b0db501f31bfb8
LSPLANT_SUBMODULE_PHASHMAP_PATH=lsplant/src/main/jni/external/dex_builder/external/parallel_hashmap
LSPLANT_SUBMODULE_PHASHMAP_URL=https://github.com/greg7mdp/parallel-hashmap.git
LSPLANT_SUBMODULE_PHASHMAP_COMMIT=0cd57d29a959256ed66b2afdd1009928fc625d09

# One source patch: references/lsplant-android17-missing-internal-hooks.patch
# makes the JIT code cache collection hook non-fatal in JitCodeCache::Init.
# The Android 17 ART this project targets removed both entry points upstream
# knows (GarbageCollectCache and master's DoCollection) in its JIT code
# cache rework, so there is no collection entry point to hook; the hook only
# moved hooked methods' data ahead of a cache collection. Everything else
# builds unmodified with the project's NDK r30 toolchain; the only other
# build inputs are CMake definitions
# (ANDROID_STL=c++_static so the std::function-based InitInfo ABI matches
# libhookengine.so, and DEBUG_SYMBOLS_PATH for upstream's post-build strip).
LSPLANT_PATCH_FILE=references/lsplant-android17-missing-internal-hooks.patch

# LSPlant master compiles its C++ modules (import std) against the `cxx`
# CMake package from org.lsposed.libcxx:libcxx, a prefab AAR whose version
# tracks the NDK release. Gradle consumers resolve it through AGP prefab;
# build_native_deps.sh downloads the same AAR from Maven Central, asserts
# this hash, and materializes the package in CMake CONFIG form.
LSPLANT_LIBCXX_VERSION=30.0.16248370
LSPLANT_LIBCXX_SHA256=8bb6839964cdd5b814255c2674a9bb4a7ba5a6b2e15284c307694a571e8d5f7c

# The CMake source root is a subdirectory of the repository, not the top level.
LSPLANT_CMAKE_SOURCE_SUBDIR=lsplant/src/main/jni
