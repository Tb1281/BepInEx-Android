# dobby (inline hook engine) build provenance.
# Consumed by scripts/build_native_deps.sh, which clones the pinned commit into
# the gitignored build/ tree and asserts it before compiling.
#
# dobby is the AArch64 inline hook engine behind the libfusion.so hook/unhook
# exports (docs/progress.md ADR 4): it is what attaches a trampoline to a
# function prologue on the device. Every hook in the port - including the ones
# ExportThunkResolver has to vet before attaching (ADR 7, ADR 8) - goes through
# it. Removing dobby removes inline hooking on Android entirely, so this pin is
# a build input and not a cleanup target.
#
# The pin is upstream master as of 2026-10-08. No fork and no prebuilt .so is
# trusted as an opaque input: libdobby.so is compiled from these exact sources
# on a CI runner, which is what makes the artifact attestable to this run and
# commit.
UPSTREAM_URL=https://github.com/canyie/dobby
# The ref the pin is compared against by scripts/check_upstream_pins.sh. dobby
# keeps its moving tip on master.
UPSTREAM_REF=master
UPSTREAM_COMMIT=6813ca76ddeafcaece525bf8c6cde7ff4c21d3ce

# Applied with `git apply --3way` to a scratch copy, never to a checkout in
# place. One patch, and it is a build fix rather than a behaviour change:
# upstream's Android logging branch includes <android/log.h> from inside a
# function body, after it is already used. The include is hoisted to the top of
# the file and guarded by __ANDROID__, which is what lets libdobby.so link
# against the NDK's liblog.
DOBBY_PATCH_FILE=references/dobby-android-log-include.patch

# dobby's CMakeLists declares cmake_minimum_required(VERSION 3.4), which CMake 4
# refuses outright. build_native_deps.sh already relaxes the policy floor
# through -DCMAKE_POLICY_VERSION_MINIMUM rather than patching the source, so no
# pin is needed for it; recorded here because it is the kind of thing that looks
# like a missing patch when the build starts failing on a newer CMake.
DOBBY_CMAKE_POLICY_VERSION_MINIMUM=3.5

# Only the arm64-v8a build is produced; the launcher ships one ABI. Prefixed, not
# bare ANDROID_ABI / ANDROID_PLATFORM, because build_native_deps.sh already
# defines API_LEVEL and passes these on its own command line - an unprefixed
# pair in a sourced env file would shadow that script's own variables.
DOBBY_ANDROID_ABI=arm64-v8a
DOBBY_ANDROID_PLATFORM=android-28