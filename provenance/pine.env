# Pine (ART hook framework) build provenance.
# Consumed by scripts/build_native_deps.sh, which clones the pinned commit into
# the gitignored build/ tree and asserts it before compiling.
#
# Pine is not a vendored convenience here. It is the Java/ART half of the hook
# engine: `PlayBillingFix` (docs/progress.md ADR 6, milestone 16) intercepts
# Play Billing JNI calls through it, and that interception is what prevents the
# JNI reference overflow on modern Unity 6000 games. Removing Pine removes that
# fix, so this pin is a build input and not a cleanup target.
#
# The pin is the tip of upstream master as of 2026-10-08. Nothing from a fork is
# taken and no prebuilt .so is trusted as an opaque input: libpine.so is compiled
# from these exact sources on a CI runner, which is what makes the artifact
# attestable to this run and commit.
UPSTREAM_URL=https://github.com/canyie/Pine
# The ref the pin is compared against by scripts/check_upstream_pins.sh. Pine
# keeps its moving tip on master.
UPSTREAM_REF=master
UPSTREAM_COMMIT=216d910f18b18430a5d21c510affb221a9833a55

# Pine carries its own git submodules, and this one is not optional: the core
# library compiles xz-embedded's C sources directly into libpine.so
# (CMakeLists.txt:16-36 pulls in linux/lib/xz/xz_{crc32,dec_lzma2,dec_stream}.c
# and puts linux/include/linux on the include path). The other nested submodule,
# enhances/src/main/cpp/external/dobby, sits in the Xposed target this port does
# not build - it is recorded for completeness and is not fetched.
#
# --recurse-submodules resolves these to whatever the *remote* points at, which
# is why they are pinned explicitly and asserted by build_native_deps.sh. Without
# that, the commit checked out here would be identical while the code compiled
# into the shipped .so could differ between two runs of the same pin - a
# reproducibility hole that no hash in this repository would catch, because the
# hash is of the top-level commit.
#
# PINE_SUBMODULE_XZ_COMMIT is also the commit the Pine tree has always resolved
# to, so recording it pins what was built rather than changing it.
PINE_SUBMODULE_XZ_URL=https://github.com/tukaani-project/xz-embedded
PINE_SUBMODULE_XZ_COMMIT=d4a9bc83c72d8087fe36ff388e89599626da7873
# Not fetched: Pine's Xposed module is not built or shipped on Android.
PINE_SUBMODULE_XPED_DOBBY_PATH=enhances/src/main/cpp/external/dobby

# Applied with `git apply --3way` to a scratch copy, never to a checkout in
# place, so a build never leaves the tree dirty. Two patches, both toolchain
# adaptations rather than behaviour changes:
#
#   1. C++ type deduction: upstream's ScopedLocalClassRef/ScopedLocalUtfStringRef
#      initialise ScopedLocalRef<T> through a base class, which newer NDK/libc++
#      headers reject (CTAD on an inherited constructor is not deducible). The
#      patch names the template argument explicitly and adds <cstddef>.
#   2. Pine's CMake asks for `find_package(cxx REQUIRED CONFIG)` and links
#      `cxx::cxx`; the NDK does not provide that package. Links c++_shared
#      directly instead.
#
# Named PINE_PATCH_FILES, not PATCH_FILE, and kept multi-line because two files
# are applied. This deliberately differs from the singular PATCH_FILE in
# monomod.env / il2cppinterop.env: those two describe one patch each, and this
# one needs a list, so a shared variable name would make the two shapes disagree
# once scripts/package_bepinex_android.sh sources more than one of these files
# into the same shell.
#
# The list is single-quoted across both lines, which is what makes it survive
# `source`: an unquoted continuation line would be executed as a command the
# moment the file is sourced. Same construct as MONOMOD_COMPONENTS in
# monomod.env, which is read line by line rather than word-split.
PINE_PATCH_FILES='references/pine-scoped-local-ref.patch
references/pine-ndk-cxx-package.patch'

# Only the core library is built. Pine also ships an Xposed module, which has no
# role on Android (Xposed is not present on a stock device); building it would
# add a target that is never packaged. Prefixed, not bare BUILD_TARGET, because
# build_native_deps.sh stages pine and dobby from one shell.
PINE_BUILD_TARGET=core

# The CMake source root is a subdirectory of the repository, not the top level.
PINE_CMAKE_SOURCE_SUBDIR=core/src/main/cpp