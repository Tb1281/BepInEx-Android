# BepInEx upstream provenance.
# Consumed by scripts/apply_patches.sh, which clones the pinned commit into the
# gitignored build/bepinex tree, asserts it, and replays the queue there.
#
# BepInEx is the framework being ported, so unlike MonoMod/Il2CppInterop there
# is no fork to reproduce: the queue in patches/ is the entire Android delta.
# The pin below is the exact upstream commit those patches are written against.
UPSTREAM_URL=https://github.com/BepInEx/BepInEx
# The ref the pin is compared against by scripts/check_upstream_pins.sh. BepInEx
# keeps its moving tip on master.
UPSTREAM_REF=master
UPSTREAM_COMMIT=4e98359b51c48f103f948c57faca3be20027407a

# Upstream description at this pin: v6.0.0-pre.2-76-g4e98359, "Upgrade UnityDoorstop
# to version 4.6.0 (#1418)", 2026-10-20. Recorded so a pin that resolves to an
# unexpected tree is recognisable at a glance rather than only by hash.
UPSTREAM_DESCRIBE=v6.0.0-pre.2-76-g4e98359

# The Android adaptation, as a directory glob rather than a list of thirteen
# filenames. The queue is applied by `patches/*.patch` in lexicographic order and
# the numbering is load-bearing: 0010 and 0011 pin Il2CppInterop and MonoMod to
# the locally rebuilt packages, so a patch that depends on them has to sort after
# them. Enumerating the files here would create a second list that can disagree
# with the glob; the count is deliberately not asserted, because adding a patch
# must not require editing this file.
#
# Replayed with `git am --3way`, not `git apply`, so the result is a chain of
# commits that can be diffed against upstream hunk by hunk. That is what lets
# scripts/sync_upstream.sh carry the port across an upstream move instead of
# silently degrading to a partial apply.
BEPINEX_PATCH_QUEUE=patches/*.patch

# Recorded, not consumed: the queue length at the time of writing, so a patch
# that goes missing is visible in review. Not a gate - the glob above is the
# authority.
BEPINEX_PATCH_COUNT=11

# The solution is passed to dotnet restore/build with an explicit SolutionDir by
# the CI workflows, and it is relative to the clone root. Recorded because
# build-bepinex.yml, verify-provenance.yml and sync-upstream.yml each pass it
# independently; after task 6 they must all pass the same value, which is the
# thing most likely to differ silently between them.
BEPINEX_SOLUTION=BepInEx.sln

# The assembly this port exists to produce, and the entrypoint libfusion resolves.
#
# The entrypoint is deliberately NOT recorded as a value here. Its source of truth
# is the string pair in launcher/app/src/main/cpp/fusion/src/dotnet.cpp
# ("BepInEx.Unity.IL2CPP.AndroidEntrypoint", "Start"), and build-bepinex.yml
# parses it out of that file with sed rather than repeating it — a rename on
# either side is meant to be a build failure, and duplicating the coordinate here
# would create a second list that could agree with a stale C++ source and disagree
# with the shipped libfusion. BEPINEX_ENTRYPOINT_SOURCE names where to look.
BEPINEX_ENTRYPOINT_SOURCE=launcher/app/src/main/cpp/fusion/src/dotnet.cpp

# Project directory, which exists in the clone. The build output lands in
# bin/Unity.IL2CPP/ inside the clone root; CI prefers that path and falls back to
# a `find`, because the retargeting patches (0005, 0008) change where the project
# file sits. Both are recorded because the two are different directories and
# conflating them is an easy mistake.
BEPINEX_PROJECT_DIR=Runtimes/Unity/BepInEx.Unity.IL2CPP
BEPINEX_OUTPUT_ASSEMBLY=bin/Unity.IL2CPP/BepInEx.Unity.IL2CPP.dll
