<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the managed build.

  This file previously hardcoded a file:///home/runner/work/<repo>/... feed, which
  exists on a GitHub runner and nowhere else, and listed no local feed. Two
  consequences: the local-nuget packages the IL2CPP build produces were
  invisible from a clean checkout, and MonoMod/Il2CppInterop resolved to whatever
  the remote feeds happened to serve.

  The local feed is declared relative to this file, so it resolves the same way
  on a runner and in a working copy. scripts/build_monomod.sh and
  scripts/build_il2cppinterop.sh populate it; both are pinned by
  provenance/monomod.env and provenance/il2cppinterop.env.
-->
<configuration>
  <packageSources>
    <add key="local-nuget" value="local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>