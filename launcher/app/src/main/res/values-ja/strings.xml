    <!-- About -->
    <string name="about_title">BepInEx Launcher</string>
    <string name="about_description">Android向け BepInEx MODローダー</string>
    <string name="about_version">バージョン %1$s (ビルド %2$d)</string>
    <string name="about_disclaimer">⚠ BepInEx Launcherは BepInEx 公式プロジェクトによって公式サポートされているものではありません。</string>
    <string name="about_projects_section">使用および参照されたプロジェクト</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP MODフレームワーク — コアプラグインローダー。BepInEx チームによる BepInEx 6.0.0-pre.2。</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight チームの Android Unity IL2CPP ランタイムコンテナ。インジェクションチェーン、Pineフック、NativeLoaderアーキテクチャの主要な参考元。</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET ランタイム (CoreCLR + BCL) を android-arm64 向けにソースビルド。暗号化はプラットフォームの BoringSSL PAL を使用。</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Javaメソッドフックフレームワーク (top.canyie.pine:core:0.3.0)。ClassLoader、PackageManager、UnityPlayerフックに使用。</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">ARM64向けネイティブインラインフックフレームワーク。libfusionのil2cpp_initフックに使用。</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPPリバースエンジニアリングツール。interopアセンブリ生成に使用。</string>
    <string name="about_dev_section">主要開発者</string>
    <string name="about_dev_names">HayashiUme · HexCat · Celestynka</string>
    <string name="about_footer">©2026 BepInEx Launcher コントリビューター</string>

