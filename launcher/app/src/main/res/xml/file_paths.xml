<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Roots for every FileProvider.getUriForFile call in this app. A path that
        is not declared here does not fail at build time — it throws
        IllegalArgumentException("Failed to find configured root") the first time a
        user taps Share — which is why these are listed against the callers rather
        than added as they are found.

        external-files-path resolves to Context.getExternalFilesDir(), which
        follows the applicationId, so no package name is hardcoded here. A test
        build's root therefore differs from production's automatically, which is
        the same property BepInExPaths relies on.

        Used by, measured by grepping every getUriForFile call in this module:
          - MainActivity          CrashDiagnostics.export -> context.cacheDir
          - GameLogOverlay        BepInExPaths.getLogFile()  <external files>/...
          - LogViewerScreen       the same log file, by path string

        The in-game log sits under BepInEx_Android/<gamePackage>/BepInEx/, one
        level deeper than the BepInEx_Android segment, because the game package
        name is part of the path (BepInExPaths.getGameRootDir).
    -->
    <external-files-path name="external_files" path="." />

    <!-- CrashDiagnostics.export writes its archive into context.cacheDir, which
         was not covered by any root here and so made the crash-diagnostics share
         action throw IllegalArgumentException at the moment of use. -->
    <cache-path name="cache" path="." />
</paths>