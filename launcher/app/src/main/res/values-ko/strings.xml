    <!-- About -->
    <string name="about_title">BepInEx Launcher</string>
    <string name="about_description">Android를 지원하는 BepInEx 모드 로더</string>
    <string name="about_version">버전 %1$s (빌드 %2$d)</string>
    <string name="about_disclaimer">⚠ BepInEx Launcher는 BepInEx 공식 프로젝트에서 공식 지원하는 소프트웨어가 아닙니다.</string>
    <string name="about_projects_section">사용 및 참고된 오픈소스 프로젝트</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP 모딩 프레임워크 — 핵심 플러그인 로더. BepInEx 팀의 BepInEx 6.0.0-pre.2 기반.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight 팀의 Android Unity IL2CPP 런타임 컨테이너. 인젝션 체인, Pine 훅 및 NativeLoader 아키텍처 주요 참고.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET 런타임(CoreCLR + BCL)을 android-arm64용으로 소스 빌드. 암호화는 플랫폼 BoringSSL PAL을 사용.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Java 메서드 후킹 프레임워크 (top.canyie.pine:core:0.3.0). ClassLoader, PackageManager, UnityPlayer 후킹에 사용.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">ARM64 네이티브 인라인 훅 프레임워크. libfusion의 il2cpp_init 후킹에 사용.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPP 리버스 엔지니어링 도구. interop 어셈블리 생성에 사용.</string>
