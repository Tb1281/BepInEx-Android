    <!-- About -->
    <string name="about_title">BepInEx Launcher</string>
    <string name="about_description">一个支持 Android 的 BepInEx 加载器</string>
    <string name="about_version">版本 %1$s (Build %2$d)</string>
    <string name="about_disclaimer">⚠ BepInEx Launcher 未获得 BepInEx 项目的官方支持。</string>
    <string name="about_projects_section">本项目使用 / 借鉴的项目</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP 模组框架 — 核心插件加载器。BepInEx 6.0.0-pre.2，由 BepInEx 团队开发。</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight 团队的 Android Unity IL2CPP 运行时容器。注入链、Pine Hook 和 NativeLoader 架构的主要参考。</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">从源码为 android-arm64 构建的 Microsoft .NET 运行时（CoreCLR + BCL）。加密使用平台 BoringSSL PAL。</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Java 方法 Hook 框架 (top.canyie.pine:core:0.3.0)。用于 ClassLoader、PackageManager 和 UnityPlayer hook。</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">ARM64 原生 Hook 框架。用于 libfusion 中的 il2cpp_init hook。</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPP 逆向工程工具。用于 interop 程序集生成。</string>
    <string name="about_dev_section">主要开发者</string>
    <string name="about_dev_names">HayashiUme · HexCat · Celestynka</string>
    <string name="about_footer">©2026 BepInEx Launcher 贡献者</string>

