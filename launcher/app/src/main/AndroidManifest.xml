<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: Used for UnityLibsDownloader (unity.bepinex.dev) and target game multiplayer/LAN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Audio & Camera: Required because this launcher hosts target game activities in its own
         ':game' process. Games or mods utilizing voice chat, proximity chat, or camera/AR/QR
         will fail with SecurityException unless declared in this host manifest. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Storage: NONE is declared, and none is needed.

        These three used to be here so a production launcher could read and write
        /sdcard/BepInEx_Android/, letting users manage mod DLLs from a file
        manager. Nothing uses that layout any more:

          - BepInExPaths.getGameRootDir() resolves through
            Context.getExternalFilesDir(null), falling back to filesDir
          - modpack import already goes through a SAF OpenDocument picker
          - the only remaining hardcoded path is in trace_log.h, and it is
            /storage/emulated/0/Android/data/<pkg>/files - app-specific storage,
            which needs no permission on any API level

        MANAGE_EXTERNAL_STORAGE is an all-files-access permission that draws
        special scrutiny in store review, so shipping it for a path the app no
        longer reads is worse than useless. Modpack import/export use SAF pickers
        instead, which grant access to exactly the file the user chose.
    -->

    <!-- Overlay & Background: Required for LogOverlayService (in-game floating real-time logcat)
         and screen dimming management on Android 13+ and 14+ -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <!-- Android 11+: discover all launchable apps for Unity IL2CPP detection -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.BepInEx.Launcher">

        <meta-data android:name="com.google.android.gms.version" android:value="12451000" />

        <!-- Bootstrap activity (FusionCore injection entry point) -->
        <activity
            android:name="com.bepinex.android.BootstrapActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:process=":game"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Main launcher activity (Compose UI) -->
        <activity
            android:name="com.bepinex.android.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Placeholder for unregistered game launcher activities.
             InstrumentationHooks rewrites startActivity to this stub, then
             restores the real game Activity in Instrumentation.newActivity. -->
        <activity
            android:name="com.bepinex.android.StubActivity"
            android:theme="@style/UnityThemeSelector"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:process=":game"
            android:exported="false" />

        <!-- Log overlay service (floating log in-game) -->
        <service
            android:name="com.bepinex.android.log.LogOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_log_overlay_for_debugging" />
        </service>

        <!-- File provider for DLL sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
